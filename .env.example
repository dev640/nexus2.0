# ---------------------------------------------------------------------------
# Backend (container / process environment)
# ---------------------------------------------------------------------------

# Database. On Railway/Render/Heroku you normally set only DATABASE_URL and let the app
# derive the JDBC URL + credentials from it. Any of these forms work:
#   DATABASE_URL=postgresql://user:pass@host:port/db        (single connection string)
#   PGHOST=... PGPORT=... PGUSER=... PGPASSWORD=... PGDATABASE=...   (discrete form)
# If SPRING_DATASOURCE_URL is set, it always wins over both.
# Supabase database alternative (URL-encode special characters in the password).
# To use this, set DATABASE_URL and comment out all three SPRING_DATASOURCE_* values below.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ktvjotwmpynbjgnqjitg.supabase.co:5432/postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nexus
SPRING_DATASOURCE_USERNAME=nexus
SPRING_DATASOURCE_PASSWORD=nexus

# Redis (optional for the whiteboard fan-out; a single instance works without it).
# Same idea: REDIS_URL=redis://default:pass@host:port (or rediss:// for TLS) is derived
# automatically, as is the discrete REDISHOST/REDISPORT/REDISPASSWORD form.
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# JWT signing secret — MUST be at least 32 bytes (256 bits) for HS256.
# Generate your own with: openssl rand -hex 32
# Leave this empty here on purpose: the app refuses to start without a real value,
# so a copied example can never become a deployment running on a public key.
NEXUS_JWT_SECRET=

# CORS: comma-separated list of browser origins allowed to call the API.
# In production set this to your deployed frontend origin.
NEXUS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth rate limiting (requests per window, per IP)
NEXUS_AUTH_RATE_LIMIT=20

# ---------------------------------------------------------------------------
# Supabase authentication (optional)
# ---------------------------------------------------------------------------
# Leave NEXUS_SUPABASE_URL empty and none of this is used: the built-in
# email/password login behaves exactly as before. Once set, the API also
# accepts Supabase access tokens as Bearer tokens — a verified Supabase user is
# matched by users.supabase_id, otherwise linked to the local account with the
# same email (its local password is then cleared), otherwise provisioned as a
# new MEMBER. The matching VITE_SUPABASE_* variables below switch the login
# screen over to Supabase.
#
# Where to find these: Supabase dashboard → Project Settings → API
#   Project URL      → NEXUS_SUPABASE_URL   (frontend: VITE_SUPABASE_URL)
#   anon public key  → VITE_SUPABASE_ANON_KEY (frontend; safe to expose)
#
# This project signs access tokens with an asymmetric ES256 key, so there is no
# usable HS256 JWT secret: tokens are verified against
# <url>/auth/v1/.well-known/jwks.json (cached, refetched on key rotation).
# Leave NEXUS_SUPABASE_JWT_SECRET empty and keep NEXUS_SUPABASE_USE_JWKS=true.
# A credential of some kind is still required, so the integration stays off
# unless it is complete. Never put the service_role / sb_secret key here — it
# is a full-access admin credential, not a signing key.
NEXUS_SUPABASE_URL=https://ktvjotwmpynbjgnqjitg.supabase.co
NEXUS_SUPABASE_JWT_SECRET=D3FXstTOvkeFDVjhzUNyrcXD7xLDqycG4NW5aqygiuLmFC0642NvBjyV8MtKC8n20nURCf4HmYYkJnoNKOiL8g==
NEXUS_SUPABASE_USE_JWKS=true
# SERVER ONLY — do not set this in Vercel, never prefix it with VITE_, and never
# commit a value. It is the Supabase Admin API key, used to create auth users and
# to set passwords, which is how admins provision accounts and issue the new
# password for a forgotten one. Two key generations are accepted — a legacy
# service_role JWT (sent on apikey *and* Authorization) or a newer sb_secret_ key
# (sent on apikey only); the server picks the headers from the key's shape, so
# rotating between them is a variable change. Leave empty to disable both
# features: they then report themselves as unavailable rather than failing at
# request time. Rotating an exposed key: OPERATIONS.md §12.
NEXUS_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imt0dmpvdHdtcHluYmpnbnFqaXRnIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MDg3NTk1MCwiZXhwIjoyMTA2NDUxOTUwfQ.ZhWq_YLFpf2AyzsJgiexMmQ8aIuyO6B-vz_oUK39sFU
NEXUS_SUPABASE_AUDIENCE=authenticated
# Optional; derived from the URL as <url>/auth/v1 when left empty.
NEXUS_SUPABASE_ISSUER=

# Optional LLM-backed Copilot. Leave NEXUS_LLM_API_KEY empty to get grounded
# (data-only) answers, which need no API key and no external calls.
#
# provider: "gemini" for Google AI Studio, or "openai" (or any OpenAI-compatible
# provider) for /chat/completions. Leaving it empty infers from the base URL.
# base-url defaults per provider:
#
#   Google AI Studio:            NEXUS_LLM_PROVIDER=gemini
#                                 NEXUS_LLM_API_KEY=...        (aistudio.google.com/apikey)
#                                 NEXUS_LLM_MODEL=gemini-2.5-flash
#   OpenAI or compatible:        NEXUS_LLM_PROVIDER=openai
#                                 NEXUS_LLM_API_KEY=sk-...
#                                 NEXUS_LLM_MODEL=gpt-4o-mini
#
# NEXUS_LLM_MODEL is required once a key is set: the Copilot stays on grounded
# answers until it is filled in. There is no default model on purpose, because a
# guessed id that no longer exists fails on every request while looking like a
# transient outage. Check your provider's current model list; these two are only
# the usual starting points.
#
# Any failure (bad key, unknown model, outage, malformed reply) falls back to
# the grounded answer, and the Copilot page names which of those it was.
NEXUS_LLM_PROVIDER=gemini
NEXUS_LLM_API_KEY=
# Overrides the per-provider default; usually leave empty.
# Gemini: https://generativelanguage.googleapis.com/v1beta
NEXUS_LLM_BASE_URL=
# Required when NEXUS_LLM_API_KEY is set. No default.
NEXUS_LLM_MODEL=

# ---------------------------------------------------------------------------
# Web Push — notifications on a phone whose app is closed (optional)
# ---------------------------------------------------------------------------
# Without these, the application still alerts an open tab over the live socket:
# nothing breaks, it simply never reaches a browser that is not running.
#
# The pair is a VAPID key pair — a P-256 EC key pair in the raw form every
# web-push tool emits: base64url, no PEM and no files. `.env.push.local` at the
# repo root is generated by the snippet in OPERATIONS.md §13, which prints these
# two values and writes them to that (gitignored) file.
# The public half is public by definition: it is served to browsers at
# GET /api/push/public-key so they can create a subscription, and it must match
# the private half. The private half signs every push as this application, so it
# belongs in the platform's secret store and nowhere else — anyone holding it
# can send notifications as Nexus.
#
# Both must be set for push to be enabled; setting only one leaves it off.
NEXUS_PUSH_VAPID_PUBLIC_KEY=BDJMFT3PodFv6_GeH2Y5rq7aFGfuWO3m3Nde61Q2pHLo7-05H0iZt40-8QflNIu2-eIGE9o_urbWSqviSmAey38
NEXUS_PUSH_VAPID_PRIVATE_KEY=kBn9zP_K44OLgsjoH6IneMq8C2NoffRi-iEVTLupu6M


# Contact address the push services require, so they can reach an operator about
# a misbehaving sender. A mailto: or https: URL.
NEXUS_PUSH_SUBJECT=mailto:ops@nexus.app

# How long a push service should hold an undelivered notification, in hours.
NEXUS_PUSH_TTL_HOURS=24

# Container platforms set PORT automatically (defaults to 8080)
# PORT=8080

# ---------------------------------------------------------------------------
# Frontend (Vite build-time variables — set these in Vercel)
# ---------------------------------------------------------------------------

# Backend API base URL — MUST end with /api, because the client appends route
# paths to it directly (VITE_API_URL + '/auth/login'). A bare host resolves to
# https://host/auth/login and every request 404s.
# Local example: http://localhost:8080/api
# Deployed example: https://your-backend.up.railway.app/api
# Leave empty only when using the Vite dev proxy, which serves /api locally.
VITE_API_URL=http://localhost:8080/api

# Optional: Supabase Auth in the browser (login, register, password reset).
# Set BOTH to use them; leaving either empty keeps the built-in email/password
# login. The anon key is a public client key and is meant to ship in the bundle.
# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://ktvjotwmpynbjgnqjitg.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Ac_asAeGsNdETH915vrw7Q_o14tslMl

# Optional: explicit WebSocket URL for the live whiteboard.
# Leave unset — it is derived from VITE_API_URL by swapping http -> ws and
# stripping a trailing /api, giving wss://your-backend.up.railway.app/ws/whiteboard
# VITE_WS_URL=wss://your-backend.up.railway.app/ws/whiteboard

# ---------------------------------------------------------------------------
# Optional: cookieless analytics (frontend, build-time)
# ---------------------------------------------------------------------------
# Leave ALL of these unset and the site loads no third-party script at all, and
# shows no consent banner — with nothing optional on the page there is nothing to
# consent to. Set a script source and the banner appears until the visitor picks
# an answer, and the script is injected only if they accept.
#
# The loader takes a script tag rather than a vendor SDK, so switching provider is
# an environment change. Set the id variable that matches your provider:
#
#   Vercel Web Analytics  VITE_ANALYTICS_SCRIPT_SRC=/_vercel/insights/script.js
#                         (also enable Web Analytics on the Vercel project)
#   Umami Cloud           VITE_ANALYTICS_SCRIPT_SRC=https://cloud.umami.is/script.js
#                         VITE_ANALYTICS_WEBSITE_ID=<website id>
#   Plausible             VITE_ANALYTICS_SCRIPT_SRC=https://plausible.io/js/script.js
#                         VITE_ANALYTICS_DOMAIN=<your domain>
#   Fathom                VITE_ANALYTICS_SCRIPT_SRC=https://cdn.usefathom.com/script.js
#                         VITE_ANALYTICS_SITE_ID=<site id>
#
# All of these are cookieless, which is what keeps this a disclosure rather than a
# consent requirement in most jurisdictions. Confirm the choice against your own
# legal advice before launch; the privacy policy describes exactly this behaviour.
#
# Local note (Windows): a value starting with "/" is rewritten by Git Bash before
# Vite sees it, so `/_vercel/insights/script.js` becomes a Windows path. Put these
# in frontend/.env.local instead (Vite loads it directly), or use a full https://
# URL for local testing. See OPERATIONS.md §11.
# Vercel Web Analytics
VITE_ANALYTICS_SCRIPT_SRC=/_vercel/insights/script.js

# Umami Cloud
VITE_ANALYTICS_SCRIPT_SRC=https://cloud.umami.is/script.js
VITE_ANALYTICS_WEBSITE_ID=

# Plausible
VITE_ANALYTICS_SCRIPT_SRC=https://plausible.io/js/script.js
VITE_ANALYTICS_DOMAIN=

# Fathom
VITE_ANALYTICS_SCRIPT_SRC=https://cdn.usefathom.com/script.js
VITE_ANALYTICS_SITE_ID=
