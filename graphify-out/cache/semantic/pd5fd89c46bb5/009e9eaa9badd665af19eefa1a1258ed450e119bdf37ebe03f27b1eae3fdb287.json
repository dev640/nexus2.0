{"nodes": [{"id": "backend_security_audit", "label": "SECURITY_AUDIT.md", "file_type": "document", "source_file": "backend/SECURITY_AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_security_audit_decision_defaults", "label": "Recorded security defaults", "file_type": "rationale", "source_file": "backend/SECURITY_AUDIT.md", "source_location": "Decisions and defaults recorded", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every hardening knob has an explicit default so a deployment can tighten it without a code change, and each choice is written down with its reasoning."}, {"id": "backend_security_audit_jwt_failfast", "label": "JWT secret fails fast", "file_type": "rationale", "source_file": "backend/SECURITY_AUDIT.md", "source_location": "Secrets and environment variables", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shipped fallback secret is a public signing key for every deployment that forgets to set one; failing at startup is louder than a silently weak deployment."}, {"id": "backend_security_audit_headers", "label": "Security headers policy", "file_type": "rationale", "source_file": "backend/SECURITY_AUDIT.md", "source_location": "Security headers and HTTPS", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "nosniff, DENY framing, referrer and permissions policy plus a CSP that blocks inline and third-party scripts while allowing the inline styles the SPA uses."}, {"id": "backend_security_audit_cors", "label": "CORS tightening", "file_type": "rationale", "source_file": "backend/SECURITY_AUDIT.md", "source_location": "Security headers and HTTPS", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allowed headers narrowed to the four the API uses, with a single origin property feeding Spring CORS."}, {"id": "backend_security_audit_rate_limits", "label": "Global and per-route rate limits", "file_type": "rationale", "source_file": "backend/SECURITY_AUDIT.md", "source_location": "Rate limiting and excess protection", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auth keeps its stricter limit while a global per-IP window backs every other API route; counters are in-memory so the budget is per instance."}, {"id": "backend_security_audit_body_cap", "label": "Declared request-body cap", "file_type": "rationale", "source_file": "backend/SECURITY_AUDIT.md", "source_location": "Rate limiting and excess protection", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A declared Content-Length over the cap is refused with 413 before the body is read; chunked requests are left to per-endpoint validation."}, {"id": "backend_security_audit_ws_bounds", "label": "WebSocket frame bounds", "file_type": "rationale", "source_file": "backend/SECURITY_AUDIT.md", "source_location": "Rate limiting and excess protection", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An authenticated socket is still an untrusted client, so frames are size-bounded and the chat socket also has a per-window frame budget."}, {"id": "backend_security_audit_error_generic", "label": "Generic error responses", "file_type": "rationale", "source_file": "backend/SECURITY_AUDIT.md", "source_location": "Error handling", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The container error path never echoes internal messages or binding details; the API handler still returns field-level validation errors where they are useful."}, {"id": "backend_security_audit_public_hygiene_gap", "label": "Public-site hygiene gap", "file_type": "concept", "source_file": "backend/SECURITY_AUDIT.md", "source_location": "Public-site hygiene", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Favicon and title exist; meta description, social preview, robots/sitemap, custom 404, skip link, cookie consent and privacy/terms pages do not."}], "edges": [{"source": "backend_security_audit", "target": "backend_security_audit_decision_defaults", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/SECURITY_AUDIT.md", "source_location": "Decisions and defaults recorded", "weight": 1.0}, {"source": "backend_security_audit", "target": "backend_security_audit_jwt_failfast", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/SECURITY_AUDIT.md", "source_location": "Secrets and environment variables", "weight": 1.0}, {"source": "backend_security_audit", "target": "backend_security_audit_headers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/SECURITY_AUDIT.md", "source_location": "Security headers and HTTPS", "weight": 1.0}, {"source": "backend_security_audit", "target": "backend_security_audit_cors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/SECURITY_AUDIT.md", "source_location": "Security headers and HTTPS", "weight": 1.0}, {"source": "backend_security_audit", "target": "backend_security_audit_rate_limits", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/SECURITY_AUDIT.md", "source_location": "Rate limiting and excess protection", "weight": 1.0}, {"source": "backend_security_audit", "target": "backend_security_audit_body_cap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/SECURITY_AUDIT.md", "source_location": "Rate limiting and excess protection", "weight": 1.0}, {"source": "backend_security_audit", "target": "backend_security_audit_ws_bounds", "relation": "references", "confidence": 