{"nodes": [{"id": "prd", "label": "PRD.md", "file_type": "document", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_workspace_vision", "label": "Single data model vision", "file_type": "concept", "source_file": "PRD.md", "source_location": "1. Problem & Vision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small teams juggle 3-5 disconnected tools and the plan drifts from the work; one shared data model is the product bet that prevents the drift."}, {"id": "prd_role_model", "label": "Workspace role model", "file_type": "concept", "source_file": "PRD.md", "source_location": "2. Users & Roles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ADMIN changes roles; MEMBER and DEVELOPER write; VIEWER is read-only intent enforced at the API by annotations rather than by the UI."}, {"id": "prd_viewer_readonly", "label": "VIEWER read-only enforcement", "file_type": "concept", "source_file": "PRD.md", "source_location": "Production-hardening plan", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only has to be enforced per endpoint, otherwise a management rule accidentally becomes \"members cannot work\" or a viewer can still write."}, {"id": "prd_grounded_copilot", "label": "Grounded Copilot answers", "file_type": "rationale", "source_file": "PRD.md", "source_location": "3.9 AI Copilot", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic answers computed from live workspace data keep the feature useful with no API key and no external call, so an unconfigured or failing provider degrades quality instead of breaking the page."}, {"id": "prd_nexus_ai_rag", "label": "Nexus AI retrieval-augmented chat", "file_type": "concept", "source_file": "PRD.md", "source_location": "3.12 Nexus AI Assistant",