", "source_location": "10. Secrets rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keys live in platform dashboards, never in the repository. The Supabase anon key is public by design; the service-role key is full access and must never be prefixed with VITE_."}, {"id": "operations_incident_checklist", "label": "Incident response checklist", "file_type": "concept", "source_file": "OPERATIONS.md", "source_location": "9. Incident checklist", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "operations_known_inconsistencies", "label": "Documented configuration inconsistencies", "file_type": "concept", "source_file": "OPERATIONS.md", "source_location": "Known inconsistencies", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "docker-compose sets NEXUS_JWT_EXPIRATION_MINUTES that nothing reads, and /api/health is a static handler that stays green while Postgres is down - both are traps for a responder."}], "edges": [{"source": "operations", "target": "operations_release_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OPERATIONS.md", "source_location": "2. Releasing", "weight": 1.0}, {"source": "operations", "target": "operations_schema_immutability", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OPERATIONS.md", "source_location": "4. Rolling back", "weight": 1.0}, {"source": "operations", "target": "operations_rollback_policy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OPERATIONS.md", "source_location": "4. Rolling back", "weight": 1.0}, {"source": "operations", "target": "operations_config_map", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OPERATIONS.md", "source_location": "7. Configuration map", "weight": 1.0}, {"source": "operations", "targe